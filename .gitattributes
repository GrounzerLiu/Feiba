# Normalize all text files to LF in both the index and the working tree.
# Binaries are explicitly marked so Git never applies the text conversion.
* text=auto eol=lf

*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
